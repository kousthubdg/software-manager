# Defaults for software-manager — copied to $HOME/AlarmCenter/software-manager/.env on first start.
# Edit the .env there (not this file) and run: docker restart software-manager
SERVICE_PORT=2999
HOST=0.0.0.0
SM_STATE_DIR=${HOME}/AlarmCenter/software-manager/data/state
SM_RELEASE_STORE=${HOME}/AlarmCenter/software-manager/data/releases
SM_BACKUP_DIR=${HOME}/AlarmCenter/software-manager/data/backups
SM_ADMIN_USER=admin
SM_ADMIN_PASSWORD=
SM_SECRET_KEY=
SM_HTTPS=true
SM_DATA_ROOT=/opt/yellowmetal
SM_RUN_UID=2759
SM_RUN_GID=2759
SM_LOGGER_URL=http://127.0.0.1:2998
LOGGER_TOKEN=
SM_MIN_FREE_GB=10
SM_BACKUP_KEEP=5
SM_RELEASE_SOURCE=/mnt/releases
SM_BUNDLE_DIR=${HOME}/AlarmCenter/software-manager/data/bundles
SM_IMPORT_DIR=${HOME}/AlarmCenter/software-manager/data/import
SM_PLATFORM=linux/amd64
SM_TRIVY=false
SM_COSIGN_PUBKEY=
SM_MQTT_ALERTS=true
BRANCH_NAME=
SM_SESSION_HOURS=12
SM_OFFLINE_AFTER_SEC=60
SM_CLOCK_SKEW_SEC=2
SM_AGENT_PORT=2997
SM_AGENT_TLS_VERIFY=false
SM_AGENT_CA_FILE=
SM_AGENT_HTTP_FALLBACK=false
SM_MQTT_DEFAULT_PORT=1883
SM_HEAVY_PODS=crowding-detection,jewelry-detection,face-recognition,postgres-database
SM_ANALYTICS_PODS=crowding-detection,jewelry-detection
SM_RESTORE_KEEP_RUNNING=mqtt
SM_HEAVY_WAIT_SEC=600
SM_POD_WAIT_SEC=300
SM_SELF_UPDATE_WAIT_SEC=600
SM_CAPACITY_BUDGET=0.7
SM_CENTRAL_URL=
SM_CENTRAL_KEY_FILE=
SM_CENTRAL_POLL_SEC=300
SM_CENTRAL_AUTO_DOWNLOAD=true
LOG_LEVEL=INFO
